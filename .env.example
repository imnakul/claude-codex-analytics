# Copy this file to .env.local only when Codex state is not in its default location.
# Use ordinary OS paths; do not commit the resulting .env.local file.

# CODEX_HOME=C:\Users\your-name\.codex
# CODEX_SQLITE_HOME=C:\path\to\codex-sqlite-state

# Claude Code normally stores transcripts and history in ~/.claude.
# CLAUDE_CONFIG_DIR=C:\Users\your-name\.claude
# Optional timestamped JSONL tool-hook logs (defaults to ~/.claude/analytics-tools if present).
# CLAUDE_LOG_DIR=C:\path\to\claude-tool-logs
